{
  "compilerOptions": {
     "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
  

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,

    "esModuleInterop": true,
  
  },

  "include": ["src"]
}